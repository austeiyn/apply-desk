# ApplyDesk environment variables
# Copy to .env.local for local development (never commit .env.local).
# On Netlify: Site configuration → Environment variables.
# Variables starting with NEXT_PUBLIC_ are embedded in the browser bundle at
# BUILD time; everything else is server-only.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → "Publishable key"
# (sb_publishable_…). The legacy "anon" key also works. Safe for browsers:
# all access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase dashboard → Project Settings → API Keys → "Secret key" (sb_secret_…)
# or the legacy "service_role" key. SERVER ONLY — bypasses RLS. Used for AI
# usage metering, rate limiting, account deletion and auth admin actions.
# Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (required for AI features) ─────────────────────────────────────
# console.anthropic.com → Settings → API Keys. SERVER ONLY.
# Without it ApplyDesk works fully except AI generation, which shows a setup notice.
ANTHROPIC_API_KEY=

# Optional: model for all AI features (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# Optional: "true" enables fast output mode on supported models
# (claude-opus-5-5): up to ~2.5x faster generation at premium pricing.
# Useful if your hosting plan has short function time limits.
ANTHROPIC_FAST_MODE=

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of the deployed site, no trailing slash, e.g. https://applydesk.example.com
# Used for email links, metadata and HTTPS-only security headers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
